{
  "name": "markydowny",
  "private": true,
  "version": "1.0.0",
  "description": "A simple, beautiful markdown viewer for the web and macOS",
  "scripts": {
    "build:frontend": "node scripts/build-frontend.mjs",
    "vendor": "node scripts/vendor.mjs",
    "dev": "tauri dev",
    "build": "tauri build",
    "test": "node --test tests/*.test.js && cargo test --manifest-path src-tauri/Cargo.toml",
    "symbols": "symbol-upload -a Markydowny -v $npm_package_version -d src-tauri/target/release -f markydowny.dSYM -m"
  },
  "devDependencies": {
    "@bugsplat/symbol-upload": "^11.0.1",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/cli": "^2.12.4",
    "esbuild": "^0.28.2",
    "marked": "^18.1.2"
  }
}
