{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markydowny",
  "version": "1.0.0",
  "identifier": "com.workingdevshero.markydowny",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run build:frontend",
    "beforeBuildCommand": "npm run build:frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Markydowny",
        "width": 900,
        "height": 1000,
        "minWidth": 400,
        "minHeight": 300
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost blob: data: https: http:",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A simple, beautiful markdown viewer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd",
          "mkdn"
        ],
        "name": "Markdown Document",
        "role": "Viewer",
        "mimeType": "text/markdown",
        "rank": "Default"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "files": {
        "Helpers/BugSplatMonitor": "bugsplat-helpers/BugSplatMonitor",
        "Helpers/BugSplatReporter.app": "bugsplat-helpers/BugSplatReporter.app"
      }
    }
  }
}
